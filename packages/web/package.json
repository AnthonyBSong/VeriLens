{
  "name": "@verilens/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run gen:samples",
    "dev": "vite",
    "prebuild": "npm run gen:samples",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "pretest": "npm run gen:samples",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run gen:samples",
    "typecheck": "tsc -b",
    "gen:samples": "node scripts/gen-samples.mjs",
    "build:html": "node scripts/build-html.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
